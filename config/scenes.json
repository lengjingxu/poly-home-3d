  "poly_home_arrive": {
    "alias": "全屋 · 回家",
    "description": "开启玄关、客厅和餐厅灯；客厅智能主灯调为 3000 K、70%。",
    "icon": "mdi:home-import-outline",
    "mode": "single",
    "sequence": [
      {
        "variables": {
          "scene_targets": "{{ expand(['light.xuan_guan_she_deng', 'light.ke_ting_zhu_deng', 'light.can_ting_zhu_deng']) | rejectattr('state', 'in', ['unavailable', 'unknown']) | map(attribute='entity_id') | list }}"
        }
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ scene_targets | count > 0 }}"
          }
        ],
        "then": [
          {
            "action": "light.turn_on",
            "target": {
              "entity_id": "{{ scene_targets }}"
            }
          }
        ]
      },
      {
        "variables": {
          "scene_targets": "{{ expand(['light.gdds_cn_2142937389_wy0a02_s_2_light']) | rejectattr('state', 'in', ['unavailable', 'unknown']) | map(attribute='entity_id') | list }}"
        }
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ scene_targets | count > 0 }}"
          }
        ],
        "then": [
          {
            "action": "light.turn_on",
            "target": {
              "entity_id": "{{ scene_targets }}"
            },
            "data": {
              "color_temp_kelvin": 3000,
              "brightness_pct": 70
            }
          }
        ]
      }
    ]
  },
